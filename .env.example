TZ=America/Santiago

# ─── MQTT Broker externo ───────────────────────────────────────────────────
# Mosquitto corre fuera de este repo — apuntar a su IP LAN
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=homeassistant
MQTT_PASSWORD=

# ─── Govee ─────────────────────────────────────────────────────────────────
GOVEE_EMAIL=
GOVEE_PASSWORD=
GOVEE_API_KEY=          # opcional — solicitar en la app Govee → About Us → Apply for API Key

# ─── eWeLink / Sonoff ──────────────────────────────────────────────────────
# ⚠️ Solo puede haber una sesión activa por cuenta.
#    La app móvil quedará desconectada mientras el bridge esté corriendo.
EWELINK_EMAIL=
EWELINK_PASSWORD=

# ─── Tuya / Nexxt ──────────────────────────────────────────────────────────
# 1. Copiar: cp config/tuya/devices.example.json config/tuya/devices.json
# 2. Rellenar con los datos de cada dispositivo (id, ip, local_key)
# 3. Obtener local_key: npm install -g @tuyapi/cli && tuya-cli wizard
